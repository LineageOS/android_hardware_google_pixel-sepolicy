get_prop(google_camera_app, vendor_gxp_prop)

allow google_camera_app edgetpu_app_service:service_manager find;
allow google_camera_app edgetpu_device:chr_file { getattr ioctl map read write };
allow google_camera_app edgetpu_device:chr_file { ioctl read write };
allow google_camera_app gxp_device:chr_file rw_file_perms;
allow google_camera_app hw_jpg_device:chr_file rw_file_perms;
allow google_camera_app iif_device:chr_file rw_file_perms;
allow google_camera_app sysfs_scsi_devices_0000:dir search;
allow google_camera_app sysfs_scsi_devices_0000:file r_file_perms;
allow google_camera_app vendor_fw_file:dir search;

allowxperm google_camera_app app_data_file:file ioctl F2FS_IOC_IO_PRIO;
